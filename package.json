{
  "name": "rms_console",
  "private": true,
  "version": "1.0.0",
  "description": "RMS Console - Full Stack Application",
  "type": "module",
  "scripts": {
    "server": "node server.js",
    "server:dev": "nodemon server.js",
    "client": "vite",
